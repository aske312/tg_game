# Create a PRIVATE copy at /root/rat-race-install.env on the server (chmod 600).
# Never commit the filled file. Existing server settings are preserved on rerun.
APP_URL=https://your-domain.example
BOT_TOKEN=123456789:replace_with_bot_token
BOT_USERNAME=your_bot
ACME_EMAIL=you@example.com
# Optional. Leave empty to generate a password in /etc/rat-race/builder-access.txt.
BUILDER_PASSWORD=
