[Unit]
Description=Rat Race game authoring service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ratrace
Group=ratrace
WorkingDirectory=/opt/rat-race/builder-current
EnvironmentFile=/etc/rat-race/builder.env
EnvironmentFile=/etc/rat-race/builder-release.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/rat-race/.venv/bin/python -m uvicorn builder.main:app --host 127.0.0.1 --port 8011 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rat-race
UMask=0077

[Install]
WantedBy=multi-user.target
